# Copy this file to .env (same folder) and fill in the values in your editor.
# Never paste these values into a chat. .env is gitignored and Claude is blocked from reading it.

# The address you log in to, e.g. https://yourschool.instructure.com
CANVAS_BASE_URL=

# Canvas -> Account -> Settings -> "+ New Access Token". Treat it like a password.
CANVAS_API_TOKEN=

# Leave empty for now. /setup lists your courses and tells you which ids to put here,
# comma-separated, e.g. 1234,5678. Only these courses can be changed.
CANVAS_COURSE_IDS=
